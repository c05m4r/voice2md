# Copia este archivo a `.env` y rellena los valores.
# Ejemplo: cp .env.example .env

# Token del bot de Telegram (obligatorio para `voice2md-bot`).
# Se obtiene de @BotFather.
TELOXIDE_TOKEN=

# Motor de transcripción del bot: "local" | "remote" (por defecto "remote").
VOICE2MD_ENGINE=local

# Ruta al modelo Whisper local (solo si VOICE2MD_ENGINE=local).
# Descarga: wget -O models/ggml-tiny.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.bin
VOICE2MD_MODEL_PATH=models/ggml-tiny.bin

# Clave de API para el motor Whisper remoto (p. ej. OpenAI).
# Solo necesaria si VOICE2MD_ENGINE=remote.
OPENAI_API_KEY=

# Ruta alternativa al archivo de configuración TOML (opcional).
# Por defecto se busca `config.toml` o `~/.config/voice2md/config.toml`.
# VOICE2MD_CONFIG=

# Log level (opcional; por defecto "info").
# error | warn | info | debug | trace
RUST_LOG=info
