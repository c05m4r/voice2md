# Copia este archivo a `.env` y rellena los valores.
# Ejemplo: cp .env.example .env

# Token del bot de Telegram (obligatorio para `voice2md-bot`).
# Se obtiene de @BotFather.
TELOXIDE_TOKEN=

# Motor de transcripción del bot: "local" | "remote" (por defecto "remote").
VOICE2MD_ENGINE=local

# Ruta al modelo Whisper local (solo si VOICE2MD_ENGINE=local).
# Descarga: wget -O models/ggml-tiny.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.bin
VOICE2MD_MODEL_PATH=models/ggml-tiny.bin

# Clave de API para el motor Whisper remoto (p. ej. OpenAI).
# Solo necesaria si VOICE2MD_ENGINE=remote.
OPENAI_API_KEY=

# Ruta alternativa al archivo de configuración TOML (opcional).
# Por defecto se busca `config.toml` o `~/.config/voice2md/config.toml`.
# VOICE2MD_CONFIG=

# Control de acceso del bot (opcional).
# El modo inicial es "public" (todos pueden transcribir); cámbialo con el
# comando /mode public|private (se persiste en el archivo de acceso).
# Lista inicial de usuarios autorizados (IDs de Telegram separados por coma).
# Cualquier usuario de esta lista puede /allow, /deny y /mode.
# VOICE2MD_WHITELIST=

# Ruta del archivo donde se persiste la whitelist y el modo (opcional).
# Por defecto "whitelist.json".
# VOICE2MD_ACCESS_FILE=whitelist.json

# Directorio donde el bot guarda las transcripciones como Markdown (opcional).
# Por defecto "notes" (relativo al directorio de ejecución).
# VOICE2MD_OUT_DIR=notes

# Log level (opcional; por defecto "info").
# error | warn | info | debug | trace
RUST_LOG=info
