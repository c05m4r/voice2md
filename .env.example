# Copia este archivo a `.env` y rellena los valores.
# Ejemplo: cp .env.example .env

# Token del bot de Telegram (obligatorio para `voice2md-bot`).
# Se obtiene de @BotFather.
TELOXIDE_TOKEN=

# Clave de API para el motor Whisper remoto (p. ej. OpenAI).
# Solo necesaria si `whisper.engine = "remote"` en config.toml.
OPENAI_API_KEY=

# Ruta alternativa al archivo de configuración TOML (opcional).
# Por defecto se busca `config.toml` o `~/.config/voice2md/config.toml`.
# VOICE2MD_CONFIG=

# Log level (opcional; por defecto "info").
# error | warn | info | debug | trace
RUST_LOG=info
